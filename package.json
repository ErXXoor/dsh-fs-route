{
  "name": "dsh-fs-route",
  "version": "1.0.0",
  "description": "Workspace-routed execution worlds for DeepSeek Harness: keep local workspaces local while ssh:// workspaces read, write, execute and open terminals on the SSH host.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ssh",
    "sftp",
    "remote",
    "workspace",
    "remote-development"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "tests"
  ],
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-shell": "0.2.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-pwsh-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.1"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  }
}
